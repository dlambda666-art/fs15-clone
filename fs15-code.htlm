<style>
.fa-heart {
  transition: color .2s ease, transform .25s cubic-bezier(.34,1.56,.64,1);
  cursor: pointer;
  -webkit-tap-highlight-color: transparent;
}
.fa-heart:hover { color: #f48625 !important; }
.fa-heart.liked {
  color: #f48625 !important;
  font-weight: 900;
}
.fa-heart.liked::before {
  content: "\f004";
  font-family: "Font Awesome 5 Free", "Font Awesome 6 Free", FontAwesome;
}
.fa-heart.fss-burst {
  animation: fssHeartPulse .55s cubic-bezier(.34,1.56,.64,1);
}
@keyframes fssHeartPulse {
  0%   { transform: scale(1); }
  20%  { transform: scale(.85); }
  45%  { transform: scale(1.45); }
  70%  { transform: scale(.95); }
  100% { transform: scale(1); }
}
.fss-heart-wrap {
  position: relative;
  display: inline-block;
  vertical-align: middle;
}
.fss-particle {
  position: absolute;
  top: 50%; left: 50%;
  width: 6px; height: 6px;
  background: #f48625;
  border-radius: 50%;
  pointer-events: none;
  opacity: 1;
  transform: translate(-50%, -50%);
  box-shadow: 0 0 6px rgba(244,134,37,.6);
}
.fss-particle.go {
  animation: fssParticleFly .7s ease-out forwards;
}
@keyframes fssParticleFly {
  0%   { opacity: 1; transform: translate(-50%, -50%) translate(0,0) scale(.5); }
  60%  { opacity: 1; }
  100% { opacity: 0; transform: translate(-50%, -50%) translate(var(--dx), var(--dy)) scale(0); }
}
.fss-mini-heart {
  position: absolute;
  top: 50%; left: 50%;
  font-size: 12px;
  color: #f48625;
  pointer-events: none;
  opacity: 0;
  transform: translate(-50%, -50%);
  text-shadow: 0 0 4px rgba(244,134,37,.5);
}
.fss-mini-heart.go {
  animation: fssMiniHeartFly 1s ease-out forwards;
}
@keyframes fssMiniHeartFly {
  0%   { opacity: 1; transform: translate(-50%, -50%) translate(0,0) scale(.4) rotate(0deg); }
  30%  { opacity: 1; }
  100% { opacity: 0; transform: translate(-50%, -50%) translate(var(--mx), var(--my)) scale(1.1) rotate(var(--mrot)); }
}
.fa-heart.fss-break {
  animation: fssHeartBreak .6s ease-in-out;
}
@keyframes fssHeartBreak {
  0%   { transform: scale(1) rotate(0deg); }
  15%  { transform: scale(1.2) rotate(-9deg); }
  32%  { transform: scale(.9) rotate(9deg); }
  50%  { transform: scale(1.08) rotate(-6deg); }
  68%  { transform: scale(.96) rotate(4deg); }
  100% { transform: scale(1) rotate(0deg); }
}
.fss-break-heart {
  position: absolute;
  top: 50%; left: 50%;
  font-size: 17px;
  pointer-events: none;
  opacity: 0;
  transform: translate(-50%, -50%);
  text-shadow: 0 0 5px rgba(0,0,0,.55);
}
.fss-break-heart.go {
  animation: fssBreakFall 1s ease-in forwards;
}
@keyframes fssBreakFall {
  0%   { opacity: 1; transform: translate(-50%, -50%) translate(0,-2px) scale(1.35) rotate(0deg); }
  25%  { opacity: 1; transform: translate(-50%, -50%) translate(0,-6px) scale(1.15) rotate(var(--br)); }
  100% { opacity: 0; transform: translate(-50%, -50%) translate(var(--bx), 36px) scale(.65) rotate(var(--br2)); }
}
.fss-shard {
  position: absolute;
  top: 50%; left: 50%;
  width: 5px; height: 5px;
  background: #8a8a8a;
  border-radius: 1px;
  pointer-events: none;
  opacity: 1;
  transform: translate(-50%, -50%);
}
.fss-shard.go {
  animation: fssShardFall .8s ease-in forwards;
}
@keyframes fssShardFall {
  0%   { opacity: 1; transform: translate(-50%, -50%) translate(0,0) scale(.6) rotate(0deg); }
  100% { opacity: 0; transform: translate(-50%, -50%) translate(var(--sx), var(--sy)) scale(.2) rotate(var(--srot)); }
}
</style>
<script>
(function(){
  if (window.__fssToggleVoteReady) return;
  window.__fssToggleVoteReady = true;
  function ensureWrap(heart) {
    if (!heart) return null;
    var p = heart.parentElement;
    if (p && p.classList && p.classList.contains('fss-heart-wrap')) return p;
    var w = document.createElement('span');
    w.className = 'fss-heart-wrap';
    heart.parentNode.insertBefore(w, heart);
    w.appendChild(heart);
    return w;
  }
  function spawnBurst(wrap) {
    if (!wrap) return;
    var n = 8;
    for (var i = 0; i < n; i++) {
      var angle = (Math.PI * 2 * i) / n + (Math.random() * 0.4 - 0.2);
      var dist = 28 + Math.random() * 14;
      var dx = Math.cos(angle) * dist;
      var dy = Math.sin(angle) * dist;
      var p = document.createElement('span');
      p.className = 'fss-particle';
      p.style.setProperty('--dx', dx.toFixed(1) + 'px');
      p.style.setProperty('--dy', dy.toFixed(1) + 'px');
      p.style.animationDelay = (i * 12) + 'ms';
      wrap.appendChild(p);
      requestAnimationFrame(function(el){ return function(){ el.classList.add('go'); }; }(p));
      setTimeout(function(el){ return function(){ el.remove(); }; }(p), 850);
    }
    for (var j = 0; j < 3; j++) {
      var mx = (Math.random() - 0.5) * 30;
      var my = -25 - Math.random() * 25;
      var mrot = (Math.random() - 0.5) * 60;
      var mh = document.createElement('span');
      mh.className = 'fss-mini-heart';
      mh.innerHTML = '♥';
      mh.style.setProperty('--mx', mx.toFixed(1) + 'px');
      mh.style.setProperty('--my', my.toFixed(1) + 'px');
      mh.style.setProperty('--mrot', mrot.toFixed(1) + 'deg');
      mh.style.animationDelay = (j * 80) + 'ms';
      wrap.appendChild(mh);
      requestAnimationFrame(function(el){ return function(){ el.classList.add('go'); }; }(mh));
      setTimeout(function(el){ return function(){ el.remove(); }; }(mh), 1100);
    }
  }
  var LK_KEY = 'fss_likes_v2';
  function lkGet(){
    try { return JSON.parse(localStorage.getItem(LK_KEY)) || {}; } catch(e) { return {}; }
  }
  function lkSet(obj){
    try { localStorage.setItem(LK_KEY, JSON.stringify(obj)); } catch(e) {}
  }
  function lkRemember(id, baseline){
    var o = lkGet(); o[id] = { b: baseline }; lkSet(o);
  }
  function lkForget(id){
    var o = lkGet(); delete o[id]; lkSet(o);
  }
  function applyLikedState(heart){
    if (!heart || heart.classList.contains('liked')) return;
    heart.classList.remove('far');
    heart.classList.add('liked', 'fas');
    heart.style.color = '#f48625';
  }
  function getCurrentCount(id){
    var container = document.getElementById('comments-ratig-layer-' + id);
    if (!container) {
      var heart = document.getElementById('heart-' + id);
      if (heart && heart.closest) container = heart.closest('#ratings-' + id);
    }
    if (!container) return 0;
    var target = container.querySelector('.ratingtypeplus, .ratingtypeplusminus') || container;
    var txt = (target.textContent || '').trim();
    var m = txt.match(/(-?\d+)/);
    return m ? parseInt(m[1], 10) : 0;
  }
  function silenceCommentsRate(){
    if (typeof window.doCommentsRate !== 'function' || window.__fssRateSilenced) return;
    window.__fssRateSilenced = true;
    var orig = window.doCommentsRate;
    window.doCommentsRate = function(a, c){
      try {
        if (typeof ShowLoading === 'function') ShowLoading("");
        $.get(dle_root + "engine/ajax/ratingcomments.php", {
          go_rate: a, c_id: c, skin: dle_skin, user_hash: dle_login_hash
        }, function(r){
          if (typeof HideLoading === 'function') HideLoading("");
          if (r && r.success) {
            var b = r.rating || '';
            b = b.replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/&amp;/g, '&');
            $("#comments-ratig-layer-" + c).html(b);
            $("#comments-vote-num-id-" + c).html(r.votenum);
          }
        }, "json");
      } catch(e) {
        if (typeof HideLoading === 'function') HideLoading("");
      }
    };
  }
  silenceCommentsRate();
  setTimeout(silenceCommentsRate, 1000);
  setTimeout(silenceCommentsRate, 3000);
  function adjustCount(id, delta){
    var container = document.getElementById('comments-ratig-layer-' + id);
    if (!container) {
      var heart = document.getElementById('heart-' + id);
      if (heart && heart.closest) container = heart.closest('#ratings-' + id);
    }
    if (!container) return;
    var target = container.querySelector('.ratingtypeplus, .ratingtypeplusminus') || container;
    var txt = (target.textContent || '').trim();
    var m = txt.match(/(-?\d+)/);
    var prefix = '';
    var newVal;
    if (m) {
      var cur = parseInt(m[1], 10);
      newVal = cur + delta;
      if (txt.charAt(0) === '+' && newVal > 0) prefix = '+';
    } else {
      newVal = delta;
      if (delta > 0) prefix = '+';
    }
    target.textContent = prefix + newVal;
    if (target.classList && target.classList.contains('ratingtypeplusminus')) {
      target.classList.remove('ratingminus','ratingplus','ratingzero');
      if (newVal > 0) target.classList.add('ratingplus');
      else if (newVal < 0) target.classList.add('ratingminus');
      else target.classList.add('ratingzero');
    }
  }
  function spawnBreak(wrap) {
    if (!wrap) return;
    var bh = document.createElement('span');
    bh.className = 'fss-break-heart';
    bh.innerHTML = '💔';
    bh.style.setProperty('--bx', ((Math.random() - 0.5) * 22).toFixed(1) + 'px');
    bh.style.setProperty('--br', ((Math.random() - 0.5) * 30).toFixed(1) + 'deg');
    bh.style.setProperty('--br2', ((Math.random() - 0.5) * 90).toFixed(1) + 'deg');
    wrap.appendChild(bh);
    requestAnimationFrame(function(){ bh.classList.add('go'); });
    setTimeout(function(){ bh.remove(); }, 1050);
    var n = 6;
    for (var i = 0; i < n; i++) {
      var side = (i % 2 === 0) ? -1 : 1;
      var sx = side * (14 + Math.random() * 16);
      var sy = 14 + Math.random() * 20;
      var p = document.createElement('span');
      p.className = 'fss-shard';
      p.style.setProperty('--sx', sx.toFixed(1) + 'px');
      p.style.setProperty('--sy', sy.toFixed(1) + 'px');
      p.style.setProperty('--srot', ((Math.random() - 0.5) * 200).toFixed(1) + 'deg');
      p.style.animationDelay = (i * 15) + 'ms';
      wrap.appendChild(p);
      requestAnimationFrame(function(el){ return function(){ el.classList.add('go'); }; }(p));
      setTimeout(function(el){ return function(){ el.remove(); }; }(p), 850);
    }
  }
  function fssApplyCount(id, r) {
    if (!(r && r.success)) return;
    var b = (r.rating || '').replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/&amp;/g, '&');
    if (b) $("#comments-ratig-layer-" + id).html(b);
    if (r.votenum !== undefined) $("#comments-vote-num-id-" + id).html(r.votenum);
  }
  window.toggleVote = function(id) {
    var heart = document.getElementById('heart-' + id);
    if (!heart) return false;
    if (heart.getAttribute('data-fsslk') === '1') return false;
    var wrap = ensureWrap(heart);
    var liked = heart.classList.contains('liked');
    heart.setAttribute('data-fsslk', '1');
    if (typeof ShowLoading === 'function') ShowLoading("");
    if (liked) {
      $.get(dle_root + "engine/ajax/fss_comment_unlike.php", {
        c_id: id, skin: dle_skin, user_hash: dle_login_hash
      }, function(r){
        if (typeof HideLoading === 'function') HideLoading("");
        heart.removeAttribute('data-fsslk');
        heart.classList.remove('liked', 'fas', 'fss-burst');
        heart.classList.add('far');
        heart.style.color = '';
        heart.classList.remove('fss-break');
        void heart.offsetWidth;
        heart.classList.add('fss-break');
        spawnBreak(wrap);
        lkForget(id);
        fssApplyCount(id, r);
      }, "json").fail(function(){
        if (typeof HideLoading === 'function') HideLoading("");
        heart.removeAttribute('data-fsslk');
      });
    } else {
      $.get(dle_root + "engine/ajax/ratingcomments.php", {
        go_rate: 'plus', c_id: id, skin: dle_skin, user_hash: dle_login_hash
      }, function(r){
        if (typeof HideLoading === 'function') HideLoading("");
        heart.removeAttribute('data-fsslk');
        heart.classList.remove('far');
        heart.classList.add('liked', 'fas');
        heart.style.color = '#f48625';
        heart.classList.remove('fss-break', 'fss-burst');
        void heart.offsetWidth;
        heart.classList.add('fss-burst');
        spawnBurst(wrap);
        lkRemember(id, 0);
        fssApplyCount(id, r);
      }, "json").fail(function(){
        if (typeof HideLoading === 'function') HideLoading("");
        heart.removeAttribute('data-fsslk');
      });
    }
    return false;
  };
  function restoreLikes(){
    var o = lkGet();
    var hearts = document.querySelectorAll('[id^="heart-"]');
    for (var i = 0; i < hearts.length; i++) {
      var idStr = hearts[i].id.slice(6);
      if (o[idStr]) applyLikedState(hearts[i]);
    }
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', restoreLikes);
  } else {
    restoreLikes();
  }
  setTimeout(restoreLikes, 800);
  setTimeout(restoreLikes, 2500);
  if (window.MutationObserver) {
    var mo = new MutationObserver(function(){ restoreLikes(); });
    document.addEventListener('DOMContentLoaded', function(){
      var root = document.getElementById('dle-ajax-comments') || document.body;
      if (root) mo.observe(root, { childList: true, subtree: true });
    });
  }
})();
</script>

