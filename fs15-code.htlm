.topnav-account-caret{font-size:11px !important;transition:transform .2s;}
.topnav-account-panel{position:absolute;top:calc(100% + 8px);right:0;min-width:250px;background:linear-gradient(180deg,#1a1a1a,#0f0f0f);border:1px solid rgba(255,140,0,0.3);border-radius:12px;box-shadow:0 12px 40px rgba(0,0,0,0.6),0 0 0 1px rgba(255,255,255,0.04) inset;padding:6px;z-index:9998;}
.topnav-account-item{display:flex !important;align-items:center;gap:12px;padding:10px 14px;color:#ddd !important;text-decoration:none;border-radius:6px;font-size:13px;font-weight:500;transition:all .12s;cursor:pointer;}
